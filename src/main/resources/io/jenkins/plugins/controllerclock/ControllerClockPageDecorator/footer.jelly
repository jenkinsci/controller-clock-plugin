<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:dd="/lib/layout/dropdowns">
  <div id="controller-clock-bootstrap"
       data-sync-url="${rootURL}/controller-clock/sync"
       data-label-synchronizing="${%synchronizing}"
       data-label-waiting="${%waitingForControllerTime}"
       data-label-sync-current="${%syncCurrent}"
       data-label-sync-stale="${%syncStale}"
       data-label-sync-unavailable="${%syncUnavailable}"
       data-label-sync-waiting="${%syncWaiting}"
       data-label-controller-zone="${%controllerZone}"
       data-label-controller-offset="${%controllerUtcOffset}"
       data-label-browser-zone="${%browserZone}"
       data-label-browser-offset="${%browserUtcOffset}"
       data-label-display-zone="${%jellyDisplayTimezoneOverride}"
       data-label-no-display-zone="${%noDisplayTimezoneOverride}"
       data-label-invalid-display-zone="${%invalidDisplayTimezoneOverride}"
       data-label-zone-mismatch="${%timeZoneIdsDiffer}"
       data-label-offset-mismatch="${%currentUtcOffsetsDiffer}"
       data-label-yes="${%yes}"
       data-label-no="${%no}"
       data-label-unknown="${%unknown}"
       hidden="hidden"></div>

  <div id="controller-clock" class="controller-clock-footer-item">
    <button id="controller-clock-trigger"
            class="jenkins-button jenkins-button--tertiary controller-clock-trigger"
            type="button"
            data-dropdown="true"
            aria-haspopup="true"
            aria-labelledby="controller-clock-accessible-label controller-clock-value">
      <span id="controller-clock-accessible-label" class="controller-clock-trigger__sr-only">${%Controller time}</span>
      <span class="controller-clock-trigger__icon" aria-hidden="true">🕒</span>
      <span id="controller-clock-value" class="controller-clock-trigger__value">${%synchronizing}</span>
    </button>
    <template>
      <div class="jenkins-dropdown jenkins-dropdown--compact controller-clock-dropdown">
        <dd:custom>
          <div class="controller-clock-popup">
            <div class="controller-clock-popup__title">${%controllerTime}</div>
            <div id="controller-clock-popup-time" class="controller-clock-popup__time">${%synchronizing}</div>
            <div class="controller-clock-popup__label">${%synchronizationStatus}</div>
            <div id="controller-clock-popup-status" class="controller-clock-popup__status">${%syncWaiting}</div>
          </div>
        </dd:custom>
      </div>
    </template>
  </div>
</j:jelly>
