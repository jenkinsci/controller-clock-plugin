<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout" xmlns:st="jelly:stapler">
  <st:adjunct includes="io.jenkins.plugins.controllerclock.controller-clock"/>

  <div id="controller-clock"
       class="controller-clock-widget"
       data-sync-url="${rootURL}/controller-clock/sync"
       data-label-controller-time="${%controllerTime}"
       data-label-synchronizing="${%synchronizing}"
       data-label-unknown="${%unknown}">
    <j:invokeStatic var="initialTooltipTime"
        className="io.jenkins.plugins.controllerclock.ControllerClockRootAction"
        method="initialTooltipTime"/>
    <j:set var="tooltip">
      <span id="controller-clock-tooltip">${%controllerTime}: ${initialTooltipTime}</span>
    </j:set>
    <span
        id="controller-clock-global"
        class="controller-clock-global"
        data-html-tooltip="${tooltip}"
        aria-label="${%controllerTime}">
      <l:icon src="symbol-time-outline plugin-ionicons-api" />
      <span id="controller-clock-global-value" class="controller-clock-global__value jenkins-mobile-hide" role="timer">${%synchronizing}</span>
    </span>
  </div>
</j:jelly>
